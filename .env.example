VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# TomTom Search (developer.tomtom.com), restringida por domínio. Melhora as
# sugestões de sítios no campo do local; sem ela usa-se o Photon (OpenStreetMap).
VITE_TOMTOM_API_KEY=

# Cloudflare Turnstile site key (Cloudflare → Turnstile → widget with the
# hostnames alinho.pt, www.alinho.pt, dev.alinho.pt, localhost). Powers the
# invisible captcha on login/signup/password recovery. Leave blank and the
# widget renders nothing — only valid while Supabase → Authentication →
# Attack Protection → Captcha is OFF; once that's on, this must be set.
VITE_TURNSTILE_SITE_KEY=

# Número de WhatsApp do robô DESTE ambiente (dígitos, com indicativo, sem +).
# Usado pelo «Enviar ao robô» da confirmação do número e pelo contacto dos
# Planos. Sem valor, usa o robô de produção (351931386496) — em dev tem de
# ser o robô ligado à BD de dev.
VITE_WHATSAPP_BOT_NUMBER=
