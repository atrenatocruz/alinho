VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Cloud project with the "Places API" enabled, key restricted by
# HTTP referrer to your domains (localhost, alinho.pt, *.vercel.app).
# Powers the club-location autocomplete in GerirClube.jsx. Leave blank in
# a given environment and the "Local" field just falls back to plain text.
VITE_GOOGLE_PLACES_API_KEY=

# Cloudflare Turnstile site key (Cloudflare → Turnstile → widget with the
# hostnames alinho.pt, www.alinho.pt, dev.alinho.pt, localhost). Powers the
# invisible captcha on login/signup/password recovery. Leave blank and the
# widget renders nothing — only valid while Supabase → Authentication →
# Attack Protection → Captcha is OFF; once that's on, this must be set.
VITE_TURNSTILE_SITE_KEY=
